# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by Edge Functions / server actions that must bypass RLS
# (e.g. invoice numbering, cross-property admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
